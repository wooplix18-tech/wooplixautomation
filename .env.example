# Optional OpenAI-compatible model provider. Without a key the system runs in
# deterministic demo mode, which is useful for local development and tests.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional Groq-compatible configuration. Set this instead of the OpenAI vars.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

AUTOMATION_DB_PATH=data/automation.db

# Same-origin dashboard works without CORS. For other clients, list exact
# allowed origins separated by commas (e.g. http://localhost:3000).
CORS_ORIGINS=

# Neon PostgreSQL. When DATABASE_URL is present, the application uses Neon
# instead of local SQLite.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Auth and Neon Functions are optional infrastructure, not used by FastAPI.
